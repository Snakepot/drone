<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.drone.user.dao.UserRoleDao">

    <select id="selectRoleIdsByUserId" resultType="java.lang.Long">
        SELECT role_id
        FROM user_role
        WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM user_role WHERE user_id = #{userId}
    </delete>

    <!-- 批量插入；调用方需保证 roleIds 非空，否则会拼出语法错误的 SQL -->
    <insert id="insertBatch">
        INSERT INTO user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <!-- 导入场景：一批用户各自对应不同的角色，成对插入 -->
    <insert id="insertBatchRefs">
        INSERT INTO user_role (user_id, role_id) VALUES
        <foreach collection="refs" item="ref" separator=",">
            (#{ref.userId}, #{ref.roleId})
        </foreach>
    </insert>

</mapper>
